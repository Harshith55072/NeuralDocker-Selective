# Copy this file to .env and fill in what you need:
#   cp .env.example .env
#
# .env is gitignored — it's never committed, and it's never overwritten by
# `git pull` or by re-running setup.sh (setup.sh only adds/updates the
# CUDA_* lines below, it won't touch your token or secrets).

# ── Ngrok (optional) ──────────────────────────────────────────────────────
# Only needed if you want other machines to join your cluster over the
# network. Leave blank for single-machine / local-only use — the ngrok
# containers will just idle without a token instead of doing anything.
# Get a free token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ── Security ──────────────────────────────────────────────────────────────
# Both of these have safe fallback defaults for local/single-machine use if
# left blank (see README > Security Notes). Set your own values before any
# shared or public deployment.
SERVICE_TOKEN=nd-service-token-change-me-in-production
JWT_SECRET=

# ── NVIDIA / CUDA (only used with docker-compose.nvidia.yml) ─────────────
# Set automatically by `./setup.sh` (option 1) if you pick a non-default
# CUDA version. Leave unset to use the pinned default (CUDA 12.4 / cu122).
# CUDA_BASE_IMAGE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
# CUDA_WHEEL_TAG=cu124
